+pub mod prof {
+    use std::cell::RefCell;
+    use std::io::Write;
+    use std::time::{Duration, Instant};
+    thread_local! {
+        static ACC: RefCell<Vec<(&'static str, u32, Duration)>> = RefCell::new(Vec::new());
+        static ON: RefCell<bool> = RefCell::new(false);
+        static FILE: RefCell<Option<std::fs::File>> = RefCell::new(None);
+    }
+    pub fn start() { ON.with(|on| *on.borrow_mut() = true); ACC.with(|a| a.borrow_mut().clear()); }
+    pub fn add(name: &'static str, took: Duration) {
+        if !ON.with(|on| *on.borrow()) { return; }
+        ACC.with(|a| { let mut a = a.borrow_mut(); match a.iter_mut().find(|e| e.0 == name) { Some(e) => { e.1 += 1; e.2 += took; } None => a.push((name, 1, took)) } });
+    }
+    pub fn time<T>(name: &'static str, f: impl FnOnce() -> T) -> T { let at = Instant::now(); let r = f(); add(name, at.elapsed()); r }
+    pub fn dump(tag: &str) {
+        ON.with(|on| *on.borrow_mut() = false);
+        let line = ACC.with(|a| a.borrow().iter().map(|(n, c, d)| format!("\"{n}\":[{c},{}]", d.as_micros())).collect::<Vec<_>>().join(","));
+        let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_micros();
+        FILE.with(|f| { let mut f = f.borrow_mut(); if f.is_none() { *f = std::fs::OpenOptions::new().create(true).append(true).open("/tmp/rini-night/prof.log").ok(); } if let Some(f) = f.as_mut() { let _ = writeln!(f, "{{\"t\":{t},\"tag\":\"{tag}\",{line}}}"); } });
+    }
+}
